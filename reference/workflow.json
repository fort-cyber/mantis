{
  "name": "mantis_vulnerability_pipeline",
  "config": {
    "db_path": "findings.db",
    "retry_attempts": 3,
    "default_model": "vertex_ai/gemini-3.6-flash",
    "seed_prompt": "Initial Task Input: Evaluate {filepath}",
    "sandbox": {
      "type": "microsandbox",
      "options": {
        "image": "mantis-sandbox:latest",
        "timeout_seconds": 30
      }
    }
  },
  "nodes": [
    {
      "id": "researcher",
      "type": "agent",
      "system_prompt": "prompts/system-researcher.md",
      "tools": ["read_file", "report_findings"]
    },
    {
      "id": "reviewer",
      "type": "agent",
      "system_prompt": "prompts/system-reviewer.md",
      "tools": ["read_file", "get_findings"],
      "output_schema": "ReviewVerdict",
      "output_key": "verdict"
    },
    {
      "id": "reviewer_classifier",
      "type": "classifier",
      "routes": ["confirmed"]
    },
    {
      "id": "reproducer",
      "type": "agent",
      "system_prompt": "prompts/system-reproducer.md",
      "tools": ["run_sandbox", "get_findings"],
      "on_enter_status": "static_confirmed",
      "output_schema": "ReproVerdict",
      "output_key": "verdict"
    },
    {
      "id": "repro_classifier",
      "type": "classifier",
      "routes": ["success"],
      "max_visits": 2
    },
    {
      "id": "patcher",
      "type": "agent",
      "system_prompt": "prompts/system-patcher.md",
      "tools": ["apply_patch", "read_file", "get_findings"],
      "on_enter_status": "dynamic_confirmed"
    },
    {
      "id": "calibrator",
      "type": "agent",
      "system_prompt": "prompts/system-calibrator.md",
      "tools": ["score_risk", "get_findings"]
    }
  ],
  "edges": [
    {"from": "START", "to": "researcher"},
    {"from": "researcher", "to": "reviewer"},
    {"from": "reviewer", "to": "reviewer_classifier"},
    {"from": "reviewer_classifier", "to": "reproducer", "on": "confirmed"},
    {"from": "reproducer", "to": "repro_classifier"},
    {"from": "repro_classifier", "to": "patcher", "on": "success"},
    {"from": "repro_classifier", "to": "reproducer", "on": "__DEFAULT__"},
    {"from": "repro_classifier", "to": "calibrator", "on": "exceeded"},
    {"from": "patcher", "to": "calibrator"}
  ]
}
